generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  position           Int       @default(0) // Drag-to-reorder display order on the Users list page - same pattern as Addon.position
  username           String    @unique
  email              String    // was @unique — now scoped by providerType below
  isActive           Boolean   @default(true)
  stremioAuthKey     String? // Encrypted Stremio auth key
  providerType       String    @default("stremio") // "stremio" | "nuvio"
  nuvioRefreshToken  String? // Encrypted Supabase refresh token
  nuvioUserId        String? // Nuvio/Supabase user UUID
  // SIMKL is an optional supplementary link, not a peer of providerType - it
  // has no addon/manifest concept at all (pure watch-tracking service), so it
  // can't be "the" provider a user is created under. Any Stremio/Nuvio user
  // can additionally connect their own personal SIMKL account: pulled watch
  // history fills the blind spot when a Nuvio account has delegated its own
  // native tracking to SIMKL (Nuvio's own Settings > Tracking), and pushed
  // history mirrors SlickSync's already-unified watch record (Nuvio+Stremio+
  // usenet) out to SIMKL - the same value the removed Trakt integration had,
  // without Trakt's one-connected-app free-tier limit that killed it.
  simklAccessToken   String? // Encrypted, 5yr expiry, no refresh flow needed
  simklConnectedAt   DateTime? // When this user linked their SIMKL account
  simklSyncState     String? // JSON: last-seen /sync/activities timestamps per category, so pull only re-fetches what actually changed
  simklLastPullAt    DateTime? // Last successful pull sweep
  simklLastPushAt    DateTime? // Watermark (createdAt cursor) for the push sweep - mirrors the removed Trakt integration's sync.trakt.lastSyncAt
  excludedAddons     String? // JSON array of addon IDs that user has excluded
  protectedAddons    String? // JSON array of addon IDs that user has protected
  colorIndex         Int? // UI color theme index
  avatarUrl          String? // Custom profile picture: full URL or /uploads/avatars/<file> for uploaded images
  useGravatar        Boolean   @default(false) // Use Gravatar for avatar instead of generated avatar
  accountId          String? // For multi-tenant support
  expiresAt          DateTime? // When user membership expires (null = never expires)
  inviteCode         String? // Invite code used to create this user (null if created manually)
  discordWebhookUrl  String? // Discord webhook URL for notifications
  discordUserId      String? // Discord user ID for personalized notifications
  notifyOnWatch      Boolean   @default(true) // Whether THIS user's watch activity (started/watched) triggers a notification at all. When discordWebhookUrl is set, their watch pings route there instead of the account's shared webhook.
  apiKey             String? // User-specific API key for accessing own metrics
  activityVisibility String    @default("private") // "public" or "private" - when public, group members can see this user's library/history
  // A genuinely public, unauthenticated share link (unlike activityVisibility
  // above, which only ever exposes data to other members of THIS account) -
  // opt-in per user, off by default. publicStatsSlug is a random unguessable
  // token (not the user's real id) so the link can be shared without
  // exposing anything else about the account. Disabling clears the slug
  // entirely rather than just flipping the flag, so a previously-shared link
  // can never work again even if re-enabled later (a fresh slug is issued).
  publicStatsEnabled Boolean   @default(false)
  publicStatsSlug    String?   @unique
  lastSyncedAt       DateTime? // When user addons were last successfully synced
  syncStatus         String? // "idle", "syncing", "success", "error"
  syncErrorMessage   String? // Last sync error message if any
  // Distinct from syncStatus/syncErrorMessage above, which is about PUSHING
  // addon config - this is about READING the user's own library/watch state
  // (activityMonitor.js's getLibraryForUser, used by both sessionTracker.js
  // and metricsProcessor.js). A live-fetch failure here silently fell back
  // to a stale cached library file with zero visibility before this field
  // existed - confirmed real case: a Stremio user's watch history went
  // quiet for over a week with nothing anywhere surfacing why. Null means
  // the most recent attempt succeeded; cleared automatically on the next
  // successful live fetch, so this self-heals once the underlying issue
  // (usually an expired session) is fixed.
  providerConnectionError   String?
  providerConnectionErrorAt DateTime?
  createdAt          DateTime  @default(now())
  // Hides this user's Sync Guardian drift alert from the Health page's
  // Attention list/notifications entirely - same treatment as Addon/
  // VaultEntry's own healthIgnored, for a known drift the admin doesn't
  // want repeated pinging about.
  healthIgnored      Boolean   @default(false)

  // Relationships

  @@unique([email, providerType])
  @@index([expiresAt])
  @@map("users")
}

// Account merge: a second provider's credentials absorbed into an existing
// User row (Stremio+Nuvio, same real person). Deliberately a side table
// rather than more nullable fields on User - User.providerType is a single
// string checked everywhere (sync's provider selection, badges, the
// [email, providerType] unique constraint), so a merged identity keeps
// that field meaning exactly what it always has ("the primary provider"),
// and every existing single-provider user is completely unaffected (zero
// rows here for the common case). userId is the SURVIVING User row from a
// merge - see server/utils/userMerge.js for how a row ends up here.
model UserProviderCredential {
  id                String   @id @default(cuid())
  userId            String
  providerType      String // "stremio" | "nuvio" - always the OTHER provider from the owning User's own providerType
  stremioAuthKey    String? // Encrypted, same scheme as User.stremioAuthKey
  nuvioRefreshToken String? // Encrypted, same scheme as User.nuvioRefreshToken
  nuvioUserId       String?
  donorId           String? // the absorbed User's original id (that row no longer exists) - lets undoMerge() find its archive
  mergeArchivePath  String? // filename under data/backup/merges/ holding the pre-merge snapshot needed to reverse this merge
  createdAt         DateTime @default(now())

  @@unique([userId, providerType])
  @@map("user_provider_credentials")
}

model Group {
  id                 String  @id @default(cuid())
  position           Int     @default(0) // Drag-to-reorder display order on the Groups list page - same pattern as Addon.position
  name               String
  description        String?
  isActive           Boolean @default(true)
  colorIndex         Int? // UI color theme index
  avatarUrl          String? // Custom group picture: full URL or /uploads/avatars/<file> for uploaded images
  accountId          String? // For multi-tenant support
  userIds            String? // JSON array of user IDs
  activityVisibility String  @default("private") // DEPRECATED: Use User.activityVisibility instead. Kept for backward compatibility.

  // Relationships
  addons GroupAddon[]

  @@map("groups")
}

// GroupMember model removed - using JSON arrays in Group model instead

model Addon {
  position Int @default(0)
  id               String  @id @default(cuid())
  name             String
  description      String?
  manifestUrl      String
  manifest         String? // Encrypted JSON string (AES-GCM)
  originalManifest String? // Encrypted original manifest JSON
  stremioAddonId   String?
  version          String?
  isActive         Boolean @default(true)
  accountId        String? // For multi-tenant support
  iconUrl          String?
  customLogo       String? // Custom logo URL to replace manifest icon
  // Deterministic hash of normalized manifestUrl for search/uniqueness (public mode)
  manifestUrlHash  String?
  // Normalized HMAC/SHA-256 of processed manifest (content equality check)
  manifestHash     String?
  // Non-sensitive cached manifest resources for fast UI (JSON string array)
  resources        String?
  // Non-sensitive cached manifest catalogs for fast UI (JSON array of catalog objects with id and type)
  catalogs         String?
  
  // Health check fields
  isOnline         Boolean  @default(true)
  lastHealthCheck  DateTime?
  healthCheckError String?
  healthIgnored    Boolean  @default(false) // hides this addon from the Health page's Attention list/notifications entirely - for a known, accepted offline addon the admin doesn't want repeated pinging about

  // Backup fields
  backupAddonId    String?  // Reference to backup addon (another Addon record)

  // User-defined single tag for drag-to-recategorize on the Addons page,
  // parallel to Vault's category field. Null = untagged. The catalog of
  // available tag NAMES lives in AppAccount.sync.addonCustomTags (JSON, same
  // pattern as custom themes) rather than a separate table, since a tag is
  // just a label with no other properties. Deleting a tag from that catalog
  // clears it (sets back to null) off every addon that had it.
  customTag        String?

  // Relationships
  groupAddons GroupAddon[]
  healthHistory AddonHealthHistory[]
  backupAddon      Addon?   @relation("AddonBackup", fields: [backupAddonId], references: [id])
  primaryAddons    Addon[]  @relation("AddonBackup")

  @@unique([name, accountId])
  @@index([manifestUrlHash])
  @@index([manifestHash])
  @@map("addons")
}

model GroupAddon {
  id        String  @id @default(cuid())
  isEnabled Boolean @default(true)
  position  Int?
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addonId   String
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([groupId, addonId])
  @@map("group_addons")
}

// Track addon health check history
model AddonHealthHistory {
  id             String   @id @default(cuid())
  addonId        String
  addon          Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)
  isOnline       Boolean
  error          String?
  checkedAt      DateTime @default(now())
  responseTimeMs Int?

  @@index([addonId, checkedAt])
  @@map("addon_health_history")
}

model AppAccount {
  id           String  @id @default(cuid())
  uuid         String? @unique
  email        String? @unique
  // Which provider's login most recently populated `email` - Stremio and
  // Nuvio admin-login both write to the same shared `email` column (there's
  // only one "linked identity" slot), so without this there's no way to
  // tell a Nuvio-linked account apart from a Stremio-linked one for display.
  linkedProvider String? // 'stremio' | 'nuvio' | null
  passwordHash String?
  // SQLite does not support Prisma Json type; store as TEXT (stringified JSON)
  sync         String?
  // Mutes the Health page's Proxy connectivity card - it's one global
  // account-wide check (no per-item entity like Addon/VaultEntry to hang a
  // healthIgnored flag off), so the mute lives here instead.
  proxyHealthIgnored Boolean @default(false)
  apiKeyHash   String? // Encrypted API key
  aiometadataManifestUrl String? // User-editable AIOMetadata addon manifest URL, used to look up posters for AIOStreams-proxy-detected Now Playing entries that have no WatchSession match
  avatarUrl    String? // Admin's own profile picture: full URL or /uploads/avatars/<file> for uploaded images
  // Below three fields exist for the superadmin panel (public multi-tenant
  // mode) - meaningless but harmless on this private, single-account
  // deployment. createdAt backfills to now() for the one pre-existing row on
  // first migration, not the account's real original creation date.
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  disabled    Boolean   @default(false) // login blocked when true; data untouched (see server/routes/superadmin.js)
  // Self-service account nickname, set from Settings by the account holder
  // themselves - meaningless but harmless on this private deployment.
  displayName String?

  // TOTP 2FA - opt-in, checked after the password/env-var check in both
  // /login and /private-login (see server/utils/twoFactor.js for why the
  // pending-challenge step in between never reuses the real session JWT
  // shape). twoFactorSecret is encrypted at rest like other secrets on this
  // model (apiKeyHash). twoFactorBackupCodes is a JSON array of bcrypt
  // hashes, never the plaintext codes - those are shown to the user exactly
  // once, at generation time, same treatment as the login password itself.
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?

  // OIDC/SSO - the external provider's stable subject id, set the first
  // time this account signs in (or is created) via /api/auth/oidc/callback.
  // See server/utils/oidc.js. Public-mode only in practice (private mode
  // logs into DEFAULT_ACCOUNT_ID directly and doesn't need this column at
  // all), but it lives on the shared model rather than a public-only one.
  oidcSubject String? @unique

  // Relationships
  invitations Invitation[]

  @@map("app_accounts")
}

// Operator action trail for the superadmin panel - meaningless but harmless
// on this private deployment, same as the three AppAccount fields above.
// See schema.postgres.prisma's copy of this model for the real doc comment.
model SuperadminAuditLog {
  id                String   @id @default(cuid())
  action            String
  targetAccountId   String
  targetAccountUuid String?
  bulk              Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("superadmin_audit_log")
}

// Automation rules ("when X happens, do Y") - see server/utils/automation/.
//
// Every automation in this app before this model was a bespoke scheduler with
// exactly one hardcoded trigger welded to one hardcoded action (vaultMonitor,
// addonScheduler, userExpiration, syncGuardian, ...). Those all still exist and
// still run - this doesn't replace them. It sits alongside as the *composable*
// layer, so a new "when a credential expires, move those users to the free
// group" doesn't need a new scheduler shipped for it.
//
// triggerConfig/conditions/actions are stringified JSON (SQLite has no Json
// type, same as itemsJson on CustomList). Shapes are validated in
// server/utils/automation/registry.js, which is the single source of truth for
// what triggers and actions actually exist - never trust these columns blind.
model AutomationRule {
  id            String   @id @default(cuid())
  accountId     String   @default("default")
  name          String
  enabled       Boolean  @default(true)
  // Trigger type key from the registry, e.g. "addon.offline".
  triggerType   String
  triggerConfig String   @default("{}")
  // JSON array of { field, op, value } - ALL must pass (AND). Empty = always.
  conditions    String   @default("[]")
  // JSON array of { type, config } run in order. A failing action is logged
  // and the remaining ones still run - one bad action shouldn't silently
  // swallow the rest of a rule the admin is relying on.
  actions       String   @default("[]")
  lastRunAt     DateTime?
  runCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs AutomationRun[]

  @@index([accountId, triggerType, enabled])
  @@map("automation_rules")
}

// One row per rule evaluation that actually fired (conditions passed), kept so
// "why did this happen / why didn't it" is answerable after the fact - an
// automation you can't audit is one you can't trust with destructive actions.
model AutomationRun {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  ruleId      String
  triggerType String
  // Stringified JSON: the event payload that fired it, plus per-action results.
  payload     String   @default("{}")
  results     String   @default("[]")
  ok          Boolean  @default(true)
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

model Invitation {
  id                     String    @id @default(cuid())
  accountId              String
  name                   String?
  inviteCode             String    @unique // Short code for URL (e.g., "abc123")
  groupName              String? // Group name to assign users to when they join
  maxUses                Int       @default(0) // 0 = unlimited uses, >0 = limited
  currentUses            Int       @default(0) // Current number of uses
  expiresAt              DateTime? // Optional expiry date for the invitation
  membershipDurationDays Int? // Membership duration in days, applied from user join time
  isActive               Boolean   @default(true)
  syncOnJoin             Boolean   @default(false) // Automatically sync user addons when they join
  createdAt              DateTime  @default(now())

  // Relationships
  account  AppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requests InviteRequest[]

  @@index([accountId])
  @@index([inviteCode])
  @@map("invitations")
}

model InviteRequest {
  id             String    @id @default(cuid())
  invitationId   String
  accountId      String
  email          String
  username       String
  status         String    @default("pending") // pending, accepted, rejected
  groupName      String? // Group name to assign user to when accepted
  oauthCode      String? // Stremio OAuth code when accepted
  oauthLink      String? // Stremio OAuth link when accepted
  oauthExpiresAt DateTime? // When OAuth link expires
  stremioAuthKey String? // Encrypted Stremio auth key from upfront OAuth
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?
  respondedBy    String? // accountId who responded

  // Relationships
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([accountId])
  @@index([email])
  @@index([status])
  @@map("invite_requests")
}

// Vault: encrypted credential/account tracking with expiry + active-check monitoring
model VaultEntry {
  id               String    @id @default(cuid())
  accountId        String    @default("default")
  name             String                          // display name, e.g. "Newshosting account"
  category         String                          // debrid | usenet_provider | usenet_indexer | stremio | nuvio | metadata | ai | vpn | aiostreams | custom
  provider         String?                         // e.g. "newshosting", "real-debrid", "nzbgeek"
  secretLabel      String    @default("API Key")   // display label for the secret field
  encryptedSecret  String                          // encrypted API key / password / token
  testType         String    @default("manual")    // manual | generic_http | real_debrid | torbox | newznab_caps | tcp_reachability
  testConfig       String?                         // JSON: { url, method, host, port, headerName, expectStatus, bodyContains }
  // Opt-in daily sweep (real_debrid/torbox entries only - see
  // debridAutoRemove.js) that deletes a torrent from the provider's own
  // account once it's finished AND has sat idle for autoRemoveAfterDays -
  // frees up account slots automatically instead of them piling up
  // indefinitely. Off by default: this is a real deletion on the provider's
  // side, not just a SlickSync-local record.
  autoRemoveEnabled   Boolean   @default(false)
  autoRemoveAfterDays Int       @default(7)
  lastAutoRemoveAt    DateTime?
  dashboardUrl     String?                         // optional link to the provider's own dashboard
  cost             Float?                          // what this service costs per `costCycle` (user-entered, in the account's configured currency) - feeds the Vault page's cost/spend summary; null = untracked
  costCycle        String    @default("monthly")   // "monthly" | "yearly" - the billing period `cost` is for; the summary normalizes yearly to monthly (÷12) before totaling
  expiresAt        DateTime?
  notifyDaysBefore Int       @default(3)
  lastCheckedAt    DateTime?
  lastCheckStatus  String?                         // ok | error | unknown
  lastCheckMessage String?
  lastNotifiedAt   DateTime?
  snoozedUntil     DateTime?                       // expiry-warning alerts suppressed until this date ("Snooze 7 days"); check-failure alerts are unaffected
  healthIgnored    Boolean   @default(false)        // hides this entry from the Health page's Attention list/notifications entirely (unlike snoozedUntil, not time-bound) - for a known, accepted failure (e.g. an indexer that blocks this host's IP) the admin doesn't want repeated pinging about
  isActive         Boolean   @default(true)
  position         Int       @default(0)             // manual ordering within a category (drag-and-drop)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId])
  @@index([accountId, category])
  @@map("vault_entries")
}

// Snapshots: saved addon-set "templates" that can be deployed to any user or group
model AddonSnapshot {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  name        String
  description String?
  addonsJson  String
  sourceType  String? // "user" | "group"
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@map("addon_snapshots")
}

// Metrics: Watch snapshots - daily snapshots of library items for delta computation
model WatchSnapshot {
  id                 String    @id @default(cuid())
  accountId          String    @default("default")
  userId             String
  itemId             String // Library item ID - the base show ID for series, not per-episode (episode identity lives in videoId below)
  date               DateTime // Date of snapshot (YYYY-MM-DD)
  overallTimeWatched String? // Total watch time in milliseconds (SQLite uses String for BigInt)
  timeOffset         String? // Current time offset in milliseconds (SQLite uses String for BigInt)
  videoId            String? // For series: which episode this snapshot's overallTimeWatched/timeOffset actually describes (e.g. "tt123456:1:5") - see getMaxOverallTimeWatched's comment for why this matters
  lastWatched        DateTime? // Last watched timestamp
  mtime              DateTime? // Library item modification time
  createdAt          DateTime  @default(now())

  @@unique([accountId, userId, itemId, date])
  @@index([accountId, userId, date])
  @@index([accountId, userId, itemId])
  @@map("watch_snapshots")
}

// Metrics: Watch activity - deltas (watch time changes) for accurate daily/weekly stats
model WatchActivity {
  id               String   @id @default(cuid())
  accountId        String   @default("default")
  userId           String
  itemId           String // Library item ID
  date             DateTime // Date of watch activity
  watchTimeSeconds Int // Delta: watch time in seconds (only positive changes)
  itemType         String // "movie" or "series"
  createdAt        DateTime @default(now())

  @@index([accountId, userId, date, itemType])
  @@index([accountId, userId, itemId])
  @@index([accountId, date])
  @@map("watch_activity")
}

// Metrics: Episode watch history - tracks individual episode watches for series
// This provides episode-level history since Stremio only keeps the last watched episode per show
model EpisodeWatchHistory {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  userId      String
  showId      String // Base show ID (e.g., "tt8080122")
  showName    String // Show name for display
  videoId     String // Full video_id (e.g., "tt8080122:4:6" or "kitsu:46676:1")
  season      Int? // Season number (null if unknown)
  episode     Int? // Episode number (null if unknown)
  episodeName String? // Episode title from Cinemeta, when known - fetched once via the same lookup used for Discord "started watching" embeds (server/utils/notify.js's fetchMetadata), not on every poll
  // Real completion for this episode - same semantics as MovieWatchHistory.completed.
  completed   Boolean?
  poster      String? // Show poster URL
  profileLabel String?
  durationSeconds Int?     // Real duration, backfilled from a matching AIOStreams-proxy WatchSession entry when the two are merged as the same viewing event // Which provider profile this was watched under (e.g. Nuvio profile name), if known
  debridService String? // e.g. "torbox" - only set when this watch was confidently correlated to a ProxyStreamSession AND a known debrid pattern was found in its resolved URL (server/utils/debridDetection.js). Null means either not proxied, or proxied but not confidently identified - never a guess either way.
  watchedAt   DateTime // When this episode was watched
  createdAt   DateTime @default(now())

  @@index([accountId, userId, watchedAt])
  @@index([accountId, userId, showId])
  @@unique([accountId, userId, videoId]) // One entry per episode per user
  @@map("episode_watch_history")
}

// Metrics: Movie watch history - the movie equivalent of EpisodeWatchHistory.
// WatchActivity records that a movie was watched (for aggregate counts/streaks)
// but has no title/poster; this table stores that display metadata reliably,
// via the same already-working pipeline that populates EpisodeWatchHistory,
// instead of relying on WatchSession (built for a different, live-detection
// purpose and much less reliably populated for either provider).
model MovieWatchHistory {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  userId    String
  itemId    String // Movie ID (e.g., "tt1234567")
  itemName  String // Movie name for display
  poster    String? // Movie poster URL
  profileLabel String?
  durationSeconds Int?     // Real duration, backfilled from a matching AIOStreams-proxy WatchSession entry when the two are merged as the same viewing event // Which provider profile this was watched under (e.g. Nuvio profile name), if known
  debridService String? // See EpisodeWatchHistory.debridService's comment - same field, same rules.
  // Real completion, from actual playback position vs runtime (state.timeOffset
  // / state.duration >= ~90%) at write time - the "genuinely finished" vs
  // "started and dropped" distinction self-reported check-ins (Trakt) can't
  // make. null = unknown (no position data, or an old row predating this),
  // true = watched to (near) the end, false = real position data but well
  // short of the end. Once true it stays true (finishing can't un-finish).
  completed Boolean?
  // Rewatch tracking (movies only). rewatchCount is how many times this movie
  // was watched to the end AGAIN after its first completion. rewatchArmed is
  // an internal edge-trigger flag: set when a finished movie's playback
  // position dips back near the start (a rewatch began), cleared when it
  // reaches the end again (which is when rewatchCount increments). This state
  // machine is deliberately isolated from all watch-time/delta math - it only
  // ever touches these two fields - so it can never inflate Watch Time. Series
  // are excluded: a per-episode position reset there is just normal
  // episode-to-episode progression, not a rewatch.
  rewatchCount Int     @default(0)
  rewatchArmed Boolean @default(false)
  watchedAt DateTime // When this movie was watched
  createdAt DateTime @default(now())

  @@index([accountId, userId, watchedAt])
  @@unique([accountId, userId, itemId]) // One entry per movie per user
  @@map("movie_watch_history")
}

// Sync Guardian: per-user "was this account synced last time we checked"
// baseline, so a transition from synced -> unsynced that SlickSync itself
// didn't cause (auto-sync off, no admin action) can be told apart from a
// user that has simply never been synced (a normal, pre-existing state, not
// a drift event). See server/utils/syncGuardian.js for the full mechanism -
// built directly off catching a real revert live on 2026-07-30.
model UserSyncGuardState {
  id            String    @id @default(cuid())
  accountId     String    @default("default")
  userId        String
  wasSynced     Boolean   @default(false)
  lastCheckedAt DateTime?

  @@unique([accountId, userId])
  @@map("user_sync_guard_state")
}

// User-curated lists of titles (roadmap #7). Account-scoped, shared across the
// account's admins (not per-user) - matches how Discover/Groups behave here.
// itemsJson is a stringified array of { id, type, name, poster?, year? };
// SQLite has no Json type (see AppAccount note), Postgres mirrors it as text
// so the router handles both identically.
model CustomList {
  id               String   @id @default(cuid())
  accountId        String   @default("default")
  name             String
  description      String?
  itemsJson        String   @default("[]")
  coverImageUrl    String?
  coverColorIndex  Int?
  // The TMDb/MDBList URL this catalog was imported from, if any - null for
  // a catalog built by hand. Lets "Refresh from source" re-pull the same
  // list later without asking the user to paste the URL again.
  importSourceUrl  String?
  // Opt-in daily re-pull of importSourceUrl (see scheduleCatalogAutoRefresh) -
  // meaningless without importSourceUrl set, so the scheduler always checks
  // both. Off by default even for imported catalogs: replacing items
  // unattended is a bigger behavior change than the existing manual
  // "Refresh" button, which always shows a diff before applying.
  autoRefresh      Boolean  @default(false)
  // 'daily' (default) or 'weekly' - how often the scheduler actually applies
  // a refresh once autoRefresh is on. The scheduler itself still ticks daily
  // (see catalogAutoRefresh.js); 'weekly' lists are just skipped on ticks
  // where lastAutoRefreshAt is under 7 days old, rather than running on a
  // separate weekly timer.
  autoRefreshFrequency String @default("daily")
  lastAutoRefreshAt DateTime?
  // Owner-set opt-in: when true, this catalog is visible (read-only) to
  // every OTHER account on this same instance, not just its own owner -
  // per-catalog, never instance-wide or admin-forced. Every mutating route
  // in routes/lists.js already scopes its query by (id, accountId), so a
  // non-owner viewer is blocked from writes purely by that existing
  // ownership check - this field only changes what GET / returns, not any
  // write-path authorization.
  shared           Boolean  @default(false)
  // Federation: when non-null, this catalog is published for OTHER SlickSync
  // instances to subscribe to, and this is the bearer token in its share URL.
  // null = not published (the default, and how you revoke). Rotating means
  // writing a new value, which invalidates the old URL immediately.
  //
  // Deliberately NOT reusing `shared` above: that means "visible to other
  // accounts on THIS instance", and quietly widening it to mean "published to
  // the internet" would expose every catalog anyone had shared internally.
  // Two different audiences, two separate opt-ins.
  federationToken  String?
  // Featured/hero treatment on the Catalogs index page - at most meaningful
  // for one catalog at a time (the client only ever shows the first pinned
  // one as the hero), but not DB-enforced as singular; a second pin just
  // means the client picks the most-recently-updated one to feature.
  pinned           Boolean  @default(false)
  // Opt-in content-rating ALLOWLIST for this catalog (e.g. a "Kids" catalog
  // whose contents feed a restricted group's addon catalogs) - a JSON array
  // of OMDb "Rated" values to KEEP ("G","PG","TV-Y", etc). Null/empty = no
  // policy (default, nothing touched). Renamed from blockedRatings
  // (formerly a flag-only review list) - this is now an active filter:
  // applying it removes every item whose rating isn't in this list. See
  // server/utils/contentRating.js and lastRemovalSnapshot below.
  keptRatings      String?
  // Full itemsJson as it was immediately before the most recent content-
  // rating removal - a one-step undo for what's otherwise a destructive
  // action, not a full history stack. Cleared (both fields null) once
  // restored, or overwritten by the next removal. null = nothing to
  // restore, either because no removal has ever run or it was already
  // restored/superseded.
  lastRemovalSnapshot String?
  lastRemovalAt    DateTime?
  // Auto-generated themed catalog (opt-in, Settings -> SlickTrax -> Auto-
  // generated catalogs; see server/utils/autoThemedCatalogs.js). False/null
  // for every hand-made or imported catalog. autoGeneratedKey is a stable
  // cluster id ("genre:Action" or "genre:Action|decade:1990") so a later
  // scan updates THIS row instead of creating a duplicate, and so a
  // user-deleted one can be recorded in DismissedThemedCatalog to stop it
  // being silently recreated next scan - same dismiss-persists-forever
  // pattern as the duplicate-account merge suggestions in userMerge.js.
  autoGenerated    Boolean  @default(false)
  autoGeneratedKey String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, autoGeneratedKey])
  @@index([accountId])
  @@map("custom_lists")
}

// Records a themed catalog the user explicitly deleted, keyed by the same
// cluster id CustomList.autoGeneratedKey uses, so runAutoThemedCatalogs
// never recreates it even if the same taste cluster is still detected on a
// later scan.
model DismissedThemedCatalog {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  key         String
  dismissedAt DateTime @default(now())

  @@unique([accountId, key])
  @@map("dismissed_themed_catalogs")
}

// Metrics: Watch sessions - tracks individual viewing sessions with start/end times
// Since Stremio only provides cumulative watch time, we track sessions during syncs
model WatchSession {
  id              String    @id @default(cuid())
  accountId       String    @default("default")
  userId          String
  itemId          String // Show/movie ID (e.g., "tt8080122")
  videoId         String? // Episode ID for series (e.g., "tt8080122:4:6")
  itemName        String // Show/movie name for display
  itemType        String // "movie" or "series"
  season          Int? // Season number for series
  episode         Int? // Episode number for series
  poster          String? // Poster URL
  startTime       DateTime // When the viewing session started
  endTime         DateTime? // When it ended (null = still watching)
  startPosition   Int? // Playback position (ms) when this session began - lets
                        // durationSeconds reflect real watched-content progress
                        // (position delta) instead of wall-clock time, since the
                        // provider's position can go stale for a while between
                        // checkpoints. Null for older sessions predating this field.
  durationSeconds Int       @default(0) // Watch duration in seconds
  requestCount    Int?     // Total request count from the underlying AIOStreams proxy connection(s), summed across stop/resume segments the same way durationSeconds is
  lastPosition    Int? // Latest known playback position (ms) - a direct
                        // snapshot value, always accurate the instant new
                        // data arrives, unlike a computed session-elapsed
                        // duration which can go stale between checkpoints
  totalDuration   Int? // Content's total runtime (ms), captured alongside
                        // lastPosition
  isActive        Boolean   @default(true) // True if session is still active
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, userId, itemId])
  @@index([accountId, userId, startTime])
  @@index([accountId, userId, isActive])
  @@index([accountId, isActive])
  @@map("watch_sessions")
}

// Dashboard: shows a user has removed from their own Continue Watching row.
// Account-scoped (not per-browser) so a dismissal made from one browser/
// device stays dismissed when checking the Dashboard from another.
model DismissedContinueWatching {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  userId    String // The show's owner (matches ContinueWatchingItem.userId), not who dismissed it - this is a single shared admin dashboard
  showId    String
  createdAt DateTime @default(now())

  @@unique([accountId, userId, showId])
  @@map("dismissed_continue_watching")
}

// SlickSync's own Trakt-alternative: personal watchlist. A bookmark list of
// things the user wants to watch — no external service, keyed to the account.
// Display fields (name, poster) are stored here rather than resolved live at
// read time so opening the watchlist doesn't need a Cinemeta round-trip per
// item — same pattern used for MovieWatchHistory / EpisodeWatchHistory.
model WatchlistItem {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  itemId    String   // IMDb-style id (tt...) matching Discover / History
  itemType  String   // "movie" | "series"
  name      String
  poster    String?
  addedAt   DateTime @default(now())

  @@unique([accountId, itemId])
  @@index([accountId, addedAt])
  @@map("watchlist_item")
}

// SlickTrax feedback: a "Not interested" action on a For You recommendation
// row. Household-wide (no userId), same scoping as WatchlistItem above -
// the recommendation engine itself operates on household-wide watch
// vectors, not per-user, so per-user "not interested" state wouldn't have
// anywhere consistent to plug into the scoring. itemType is stored (not
// looked up at read time) because computeNotInterestedPenalties needs the
// "movie:<id>" / "series:<id>" affinity key format to find similar items to
// downweight, and re-deriving type from itemId alone isn't reliable.
model NotInterestedItem {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  itemId    String
  itemType  String   // "movie" | "series"
  createdAt DateTime @default(now())

  @@unique([accountId, itemId])
  @@map("not_interested_items")
}

// SlickTrax feedback: 👍/❤️/👎 on a title - the replacement for a declined
// "comments" feature, explicitly meant to feed recommendation scoring (see
// server/utils/recommendationEngine.js's computeSignedAdjustments), not just
// decorate the detail modal. Household-wide (no userId) and one-per-item
// (upsert-replace, not a running tally) - same scoping reasoning as
// NotInterestedItem above. itemType stored for the same "build an affinity
// key without re-deriving type" reason as that model too.
model TitleReaction {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  itemId    String
  itemType  String   // "movie" | "series"
  reaction  String   // "like" | "love" | "dislike"
  itemName  String?
  poster    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, itemId])
  @@map("title_reactions")
}

// SlickTrax feedback: a personal 1-10 rating, also feeding recommendation
// scoring (same mechanism as TitleReaction above - see
// computeSignedAdjustments). `season` distinguishes an overall/whole-item
// rating (0 - the only value movies ever use) from a specific season's
// rating (1+, series only) - kept as a non-null sentinel rather than a
// nullable column because SQL NULL isn't equal to itself for uniqueness
// purposes, which would have let duplicate "overall" rows slip past
// @@unique. A series can carry both an overall (season 0) rating AND
// per-season ratings at once - they're independent opinions ("solid show
// overall, but season 3 was rough"), not a strict hierarchy.
model TitleRating {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  itemId    String
  itemType  String   // "movie" | "series"
  season    Int      @default(0)
  rating    Int      // 1-10
  itemName  String?
  poster    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, itemId, season])
  @@index([accountId, itemId])
  @@map("title_ratings")
}

// Manual override for the "watched" indicator on Discover posters. Lets a
// user mark something as watched even though they don't have polled watch
// history for it (e.g. they saw it on a different service), OR mark it as
// NOT watched to clear a false positive (e.g. accidentally opened the file).
// Overrides win over the real MovieWatchHistory / EpisodeWatchHistory rows
// in the watched-status endpoint but do NOT delete them — the underlying
// history is preserved untouched, so clearing an override falls back to
// whatever the poller has actually observed.
model ManualWatchOverride {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  itemId    String   // IMDb id (tt...)
  watched   Boolean  // true = force watched, false = force not-watched
  markedAt  DateTime @default(now())

  @@unique([accountId, itemId])
  @@map("manual_watch_override")
}

// Per-episode dismissals for the Dashboard "Coming up" panel. Keyed by the
// exact (season, episode) tuple so that when the poller advances a show's
// next-upcoming episode to a different one, the new one is NOT filtered out —
// dismiss-this-episode naturally becomes "hide until the next episode is
// announced," which matches how users think about the panel.
model DismissedUpcomingEpisode {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  showId    String
  season    Int
  episode   Int
  createdAt DateTime @default(now())

  @@unique([accountId, showId, season, episode])
  @@map("dismissed_upcoming_episode")
}

// Queued summary lines for notification digest mode (AppAccount.sync's
// notifyDigestEnabled) - an opt-in alternative to instant Discord pings.
// Written instead of an instant postDiscord() call at each notify call site
// when digest mode is on; a periodic poller (notificationDigest.js) batches
// everything since the last send into one message, then deletes the
// consumed rows. Never touched when digest mode is off - Discord behavior
// is completely unchanged for anyone who doesn't opt in.
model NotificationDigestEntry {
  id        String   @id @default(cuid())
  accountId String
  category  String // 'episode' | 'sync' | 'vault' | 'addon_health'
  summary   String
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("notification_digest_entry")
}

// A whole-show opt-out from upcoming-episode tracking - unlike
// DismissedUpcomingEpisode (hides one occurrence, reappears once the poller
// advances to the next episode), muting a show stops it being tracked at
// all: no more Coming Up entries, no more new-episode alerts (push/Discord),
// until unmuted. See episodeAlerts.js's checkForNewEpisodes/getUpcomingEpisodes.
model MutedShow {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  showId    String
  showName  String?
  poster    String?
  createdAt DateTime @default(now())

  @@unique([accountId, showId])
  @@map("muted_show")
}

// New-episode alerts: per-show baseline of the latest RELEASED episode we
// last saw in Cinemeta's episode list. The episodeAlerts poller compares
// against this on each run - anything newer means a new episode dropped for
// a show someone here is actively watching. Baseline-only rows (first time a
// show is seen) never fire an alert; without the baseline, every backlog
// episode of a newly-tracked show would "alert" at once.
model ShowEpisodeAlertState {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  showId      String
  lastSeason  Int
  lastEpisode Int
  // Next UPCOMING (future-dated) episode from Cinemeta, refreshed every poll —
  // powers the Dashboard "Coming up" calendar. Null when the show has no
  // announced future episode (caught up / ended). Display fields are stored
  // here too so the calendar endpoint needs no extra Cinemeta lookup.
  showName    String?
  poster      String?
  nextSeason  Int?
  nextEpisode Int?
  nextTitle   String?
  nextAirDate DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([accountId, showId])
  @@index([accountId, nextAirDate])
  @@map("show_episode_alert_state")
}

// One row per new-episode alert actually fired - both the dedupe record (the
// unique constraint means an episode can never alert twice, even across
// restarts) and the feed the notification bell reads.
model EpisodeAlert {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  showId    String
  showName  String
  season    Int
  episode   Int
  title     String? // Episode title from Cinemeta, when known
  poster    String?
  createdAt DateTime @default(now())

  @@unique([accountId, showId, season, episode])
  @@index([accountId, createdAt])
  @@map("episode_alerts")
}

// addonHealthCheck.js's periodic check already flips Addon.isOnline and
// (via getGroupAddons) silently diverts groups to their configured backup
// addon - nothing ever told anyone that happened. One row per transition
// (offline or back online), read by the notification bell the same way
// EpisodeAlert is; Discord/push fire from the same event, gated on the
// notifyOnAddonHealth toggle (server/routes/settings.js).
model AddonHealthAlert {
  id              String   @id @default(cuid())
  accountId       String   @default("default")
  addonId         String
  addonName       String
  event           String // 'offline' | 'online'
  backupAddonId   String?
  backupAddonName String?
  groupCount      Int      @default(0) // groups with this addon assigned, i.e. groups actually affected by the swap
  errorMessage    String? // health-check error, set on 'offline' events only
  createdAt       DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("addon_health_alerts")
}

// Periodic sample of the SQLite DB file's own size, for the Tasks page's
// size-over-time chart - private-mode only (public mode runs Postgres, which
// has no single file to stat). Read-only reporting: no action is ever taken
// on this data, it exists purely to catch a runaway table before disk fills
// up on a small VPS.
model DbSizeSample {
  id        String   @id @default(cuid())
  accountId String   @default("default")
  bytes     BigInt
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("db_size_samples")
}

// Generic persistent in-app notification - the durable backing store for the
// notification bell. Before this, the bell had NO event store: it re-derived
// watch notifications live from the metrics snapshot every poll, so a
// "started/finished watching" event that push and Discord fired as discrete,
// persistent events never produced a matching bell entry (the bell only ever
// showed a transient "is watching" row while a session was live in Now
// Playing, and a "completed" row only if the NATIVE pipeline happened to
// record it - so a proxy-only watch, or a watch under a mismatched Stremio
// account, left the bell empty while push/Discord both fired for it). That
// directly broke the "push + bell are primary" rule. This table fixes it at
// the root: every notification dispatch writes one row here, so bell + push +
// Discord are all fed from one place instead of three disconnected paths.
// EpisodeAlert/AddonHealthAlert keep their own dedicated tables (they predate
// this and already feed the bell), so they are deliberately NOT duplicated here.
//
// dedupeKey makes a dispatch idempotent across restarts/re-polls: a stable key
// (e.g. "watch-start-<sessionId>") means the same event can never create two
// rows. Nullable, and SQLite treats NULLs as distinct in a unique index, so
// rows that don't need dedupe (dedupeKey null) never collide. read/readAt are
// server-side so read state is consistent across devices - the bell's old
// localStorage-only read state was per-browser and reset on every new device.
model Notification {
  id        String    @id @default(cuid())
  accountId String    @default("default")
  type      String // 'activity' | 'sync' | 'vault' | 'mismatch' - drives the bell's category icon
  title     String
  body      String
  poster    String?
  url       String? // deep-link the bell row navigates to on click
  data      String? // optional JSON blob for extra per-type context
  dedupeKey String? // stable idempotency key; null = always create a new row
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([accountId, dedupeKey])
  @@index([accountId, createdAt])
  @@map("notifications")
}

// PWA web-push subscriptions - one row per browser/device that opted in to
// native push notifications. endpoint is the push service URL; p256dh/auth
// are the browser-provided encryption keys web-push needs. Unique on
// endpoint so re-subscribing the same device updates rather than duplicates.
model PushSubscription {
  id         String    @id @default(cuid())
  accountId  String    @default("default")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  label      String? // user-set friendly name ("Living room TV") shown in Settings -> Devices; falls back to a parsed userAgent guess when unset
  lastSeenAt DateTime? // last successful push send to this device, so a stale/dead subscription is visible at a glance
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@map("push_subscriptions")
}

// Metrics: Proxy stream sessions - "Now Playing" data sourced from AIOStreams'
// built-in proxy (which sees every stream request passing through it in real
// time, regardless of provider - Stremio, Nuvio, anything using the proxy).
// Deliberately NOT merged into WatchSession: WatchSession was built for a
// different, live-detection purpose and is currently unreliably populated for
// both providers (see MovieWatchHistory comment above). This table is fully
// independent so the AIOStreams integration doesn't inherit that bug, and so
// it keeps working regardless of whether/how the WatchSession issue is fixed.
//
// Identity key matches AIOStreams' own BuiltinProxyStats: it keys connections
// by (ip, url), not by a single requestId - concurrent requests (e.g. range
// requests for the same file) merge into one entry with a growing/shrinking
// requestIds[] array and a count. So (accountId, aiostreamsUser, clientIp,
// url) is the real stable identity here, not requestId.
model ProxyStreamSession {
  id              String    @id @default(cuid())
  accountId       String    @default("default")
  aiostreamsUser  String    // Username as reported by AIOStreams proxy stats (may not map 1:1 to a SlickSync User)
  clientIp        String    // AIOStreams' `ip` field - client IP that opened this connection
  url             String    // Full upstream URL being proxied (may contain the raw source link) - part of AIOStreams' own identity key alongside ip
  filename        String?   // Raw filename AIOStreams reported, e.g. "Powder.1995.1080p.AMZN.WEB-DL.DD5.1.H.264-SiGMA"
  displayName     String?   // Best-effort cleaned-up title parsed from filename, e.g. "Powder (1995)"
  posterUrl       String?   // Poster URL from an AIOMetadata search lookup, cached so we don't re-query on every poll while a stream is still active
  metadataMatchedAt DateTime? // When the AIOMetadata lookup was attempted (whether or not it found a match) - null means not yet attempted
  metadataItemId   String?   // Real IMDb-style ID from the AIOMetadata match, e.g. "tt1032819" - used to key the completed-history WatchSession row when this stream ends
  metadataItemType String?   // "movie" or "series" from the AIOMetadata match
  linkedWatchSessionId String? // ID of the WatchSession row this stream's completed history was written to, if any - lets a poster found later (e.g. by the retry pass) backfill into the history entry too, not just this row
  requestCount    Int       @default(1) // AIOStreams' `count` - number of individual requests merged into this entry
  startTime       DateTime  // AIOStreams' `timestamp` - when this connection was first opened
  lastSeenAt      DateTime  // AIOStreams' `lastSeen` - most recent activity on this connection, updates as long as it's active
  endTime         DateTime? // When AIOStreams stopped reporting this active (null = still active)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, aiostreamsUser, clientIp, url])
  @@index([accountId, isActive])
  @@index([accountId, aiostreamsUser, isActive])
  @@map("proxy_stream_sessions")
}

// Remembers which managed user a client IP resolved to the last time there
// was a REAL signal (a unique direct/email match, or a native title match) -
// used as the tiebreaker for FUTURE ambiguous proxy attributions from the
// same IP, instead of a fixed AIOSTREAMS_FALLBACK_USER_IDS order. See
// proxyNowPlaying.js's disambiguateMatch. Most households have one device
// per person on a fairly stable local IP, so "who was confirmed on this IP
// last time" is a much better guess than a static id order - and unlike the
// static order, it can never be wrong in the SAME way twice once it's had
// one confident observation to learn from.
model ProxyUserIpAffinity {
  id          String   @id @default(cuid())
  accountId   String   @default("default")
  clientIp    String
  userId      String
  confirmedAt DateTime @default(now())

  @@unique([accountId, clientIp])
  @@map("proxy_user_ip_affinity")
}
