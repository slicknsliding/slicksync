{
  "name": "SlickSync",
  "short_name": "SlickSync",
  "description": "SlickSync - Stremio Group Manager",
  "icons": [
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "start_url": "/",
  "scope": "/",
  "shortcuts": [
    {
      "name": "Activity",
      "short_name": "Activity",
      "description": "Watch history and Now Playing",
      "url": "/activity",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Discover",
      "short_name": "Discover",
      "description": "Browse and search titles",
      "url": "/discover",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "System Health",
      "short_name": "Health",
      "description": "Is everything working right now",
      "url": "/metrics?tab=health",
      "icons": [{ "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "display": "standalone",
  "theme_color": "#6d28d9",
  "background_color": "#ffffff"
}